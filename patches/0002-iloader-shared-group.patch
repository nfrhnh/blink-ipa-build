 + (NSString *) infoPlistFullGroupID {
-  return [NSString stringWithFormat:@"group.%@", [self infoPlistGroupID]];
+  // iLoader registers a group named after the re-signed containing app.
+  // The File Provider runs in a separate process, so find the containing app
+  // when the main bundle is an extension.
+  NSBundle *appBundle = [NSBundle mainBundle];
+  if ([appBundle.bundleURL.pathExtension isEqualToString:@"appex"]) {
+    NSURL *appURL = [[appBundle.bundleURL URLByDeletingLastPathComponent] URLByDeletingLastPathComponent];
+    appBundle = [NSBundle bundleWithURL:appURL];
+  }
+  NSString *bundleID = appBundle.bundleIdentifier;
+  return bundleID ? [@"group." stringByAppendingString:bundleID]
+                  : [NSString stringWithFormat:@"group.%@", [self infoPlistGroupID]];
 }
 
 
